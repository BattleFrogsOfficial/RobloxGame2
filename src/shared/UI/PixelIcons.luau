function PixelIcons.GridSize(name: string): number
	local rows = PixelIcons.Icons[name]
	return if rows then #rows else PixelIcons.Size
end

function PixelIcons.Has(name: string): boolean
	return PixelIcons.Icons[name] ~= nil
end

return PixelIcons
